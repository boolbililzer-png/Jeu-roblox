			{ "PilierSucreOrge2", "cyl", V(4, 70, 4), V(40, 20, -26), C(255, 120, 120), "SmoothPlastic" },
			{ "Lanterne1", "ball", V(5, 6, 5), V(-20, 46, -25), C(120, 255, 160), "Neon" },
			{ "Lanterne2", "ball", V(5, 6, 5), V(20, 46, -25), C(255, 200, 80), "Neon" },
