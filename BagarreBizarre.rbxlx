		follow = { Root = { -18, 0, 0 }, Waist = { -34, 0, 0 }, RS = { 0, 0, 10 }, RE = { 5, 0, 0 }, RW = { -10, 0, 0 }, LS = { -30, 0, -50 }, LE = { 20, 0, 0 }, RH = { 10, 0, 0 }, RK = { -35, 0, 0 }, LH = { 20, 0, 0 }, LK = { -55, 0, 0 } },
