			-- il enferme l'adversaire dans une boîte invisible, la plie encore et encore jusqu'à la taille d'un
			-- mouchoir, et la range dans sa poche
			scene = {
				{ "spawn", at = "target", offset = Vector3.zero, life = 2.2, pieces = {
