		strike = { Root = { -16, 30, 0, 0, -0.4, -0.5 }, Waist = { -14, 40, 0 }, Neck = { -6, -20, 0 }, RS = { 95, 0, -10 }, RE = { 10, 0, 0 }, LS = { -20, 0, -45 }, LE = { 50, 0, 0 }, FL = { 0, 0, 0, 0, 0, -0.5 } },
