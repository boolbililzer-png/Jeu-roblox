	{ "ball", Vector3.new(0.22, 0.9, 0.18), Vector3.new(0.45, 1.3, 0.15), RABBIT },
	{ "ball", Vector3.new(0.22, 0.9, 0.18), Vector3.new(0.7, 1.25, -0.15), RABBIT },
