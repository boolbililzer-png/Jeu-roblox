		{ 0.5, { Root = { 0, 0, -3, 0, 0, 0 }, Waist = { 0, 0, -3 }, Neck = { 25, 0, 0 }, RS = { 178, 0, 5 }, RE = { 5, 0, 0 }, RW = { 0, 0, 0 }, LS = { 10, 0, -30 }, LE = { 20, 0, 0 } } },
