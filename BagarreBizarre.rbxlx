	{ "block", Vector3.new(0.5, 1.0, 0.4), Vector3.new(0, 0.1, 0), SOCK },
	{ "block", Vector3.new(0.5, 0.4, 0.85), Vector3.new(0, -0.5, 0.25), SOCK },
	{ "block", Vector3.new(0.55, 0.25, 0.42), Vector3.new(0, 0.5, 0), WHITE },
} }
