		{ 1.3, { Root = { 4, 0, 0, 0, -0.15, 0 }, Waist = { 14, 6, 0 }, Neck = { 32, -10, 0 }, RS = { 148, 0, -22 }, RE = { 110, 0, 0 }, RW = { -122, 0, 0 }, LS = { 25, 0, -2 }, LE = { 100, 0, 0 } } },
		{ 1.55, { Waist = { -2, 6, 0 }, Neck = { 0, -10, 0 }, RS = { 30, 0, 14 }, RE = { 60, 0, 0 }, LS = { 75, 0, 30 }, LE = { 120, 0, 0 } } },
		{ 1.8, {} },
