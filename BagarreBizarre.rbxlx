		follow = { Root = { 6, 0, 0, 0, 0.45, 0 }, Waist = { 12, 0, 0 }, Neck = { 24, 0, 0 }, RS = { 180, 0, 4 }, RE = { 5, 0, 0 }, LS = { 25, 0, -42 }, LE = { 40, 0, 0 }, RH = { 15, 0, 0 }, RK = { -30, 0, 0 }, LH = { 55, 0, 0 }, LK = { -95, 0, 0 } },
