			{ "Meche", "Head", "wedge", Vector3.new(0.35, 0.55, 0.6), Vector3.new(0.15, 0.95, -0.25), Vector3.new(-20, 0, -15), CHEVEUX, "Fabric" },
			-- casque gamer RGB avec micro
