		{ 1.75, { Root = { 0, 0, 0, 0, -0.1, 0 }, Waist = { -40, 0, 0 }, Neck = { -10, 0, 0 }, RS = { 40, 0, -30 }, RE = { 100, 0, 0 }, LS = { -40, 0, -50 }, LE = { 10, 0, 0 } } },
