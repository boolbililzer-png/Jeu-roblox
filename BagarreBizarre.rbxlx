		{ 0.85, { Root = { 2, 0, 0, 0, -0.35, 0 }, Waist = { 10, 0, 0 }, Neck = { 25, 0, 0 }, RS = { 170, 0, 15 }, RE = { 15, 0, 0 }, RW = { 0, 0, 0 }, LS = { 40, 0, -45 }, LE = { 30, 0, 0 } } },
